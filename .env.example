# ── LLM causal-insight layer (demo/app only — NOT used by the scored run.sh) ─
# Copy to `.env` and fill in a key. Any OpenAI-compatible endpoint works.
#
# Default = Groq (free, fast, generous limits). Get a key: https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30

# Other providers (just swap the three values):
#   OpenRouter (free models): LLM_BASE_URL=https://openrouter.ai/api/v1
#                             LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   xAI Grok:                 LLM_BASE_URL=https://api.x.ai/v1   LLM_MODEL=grok-2-latest
#   OpenAI:                   LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
