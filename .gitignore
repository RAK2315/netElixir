# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Env / secrets — never commit API keys
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Run artifacts (regenerated by run.sh; must NOT be committed)
output/
features.parquet
*.log

# Presentation image assets (local only, for building the slide deck)
/images/
netElixir.zip

# NetElixir-provided briefing docs — keep out of the public repo (confidential)
*.pdf
# ...but DO track our own generated reports in docs/
!docs/*.pdf
# ...except the confidential NetElixir briefs stay ignored even inside docs/
docs/AIgnition Project Brief 2026.pdf
docs/hackathon-submission-guide.pdf
# Original provided dataset dump (the runnable sample lives in data/ instead)
/datasets/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/

# NOTE: pickle/model.pkl and data/*.csv are intentionally TRACKED
# (the scorer needs the committed model and a runnable sample dataset).
